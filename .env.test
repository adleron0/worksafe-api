# Ambiente da suíte e2e. Valores fixos e descartáveis — nenhum segredo real aqui.
# Sobe a infra com: docker compose -f docker-compose.test.yml up -d

DATABASE_URI="postgresql://worksafe:worksafe@localhost:55432/worksafe_test?schema=public"

REDIS_HOST=localhost
REDIS_PORT=56379

# R7 da revisão de risco: o rate limit global (100 req/min) e o de /classes
# (10 req/min) derrubam a própria suíte com falhas intermitentes.
SECURITY_ENABLED=false

# Gotcha documentado: com BASE_SETUP=development o AsaasService ignora o token
# da empresa e usa TOKEN_ASAAS_SANDBOX, mascarando bugs de resolução de
# credencial. A suíte roda em "production" contra o Asaas mockado por nock.
BASE_SETUP=test
NODE_ENV=test

JWT_ACCESS_SECRET=test-access-secret-nao-usar-fora-de-teste
JWT_REFRESH_SECRET=test-refresh-secret-nao-usar-fora-de-teste
JWT_STUDENT_SECRET=test-student-secret-nao-usar-fora-de-teste
JWT_VISITOR_SECRET=test-visitor-secret-nao-usar-fora-de-teste

# Precisa ter exatamente 32 chars: é a chave AES-256-CBC do payload do JWT.
PAYLOAD_ACCESS_SECRET=0123456789abcdef0123456789abcdef

LOGS_DB=false
ORIGIN_CORS=http://localhost:3000
TRUST_PROXY_HOPS=0
PORT=3999

# Nenhuma chamada real sai da suíte: o nock intercepta api.asaas.com.
WEBHOOK_URL=https://api.test.local

# S3: exigido em tempo de IMPORT por upload.middleware.ts, antes mesmo de o
# Nest subir. Valores falsos de propósito — nenhum upload acontece na suíte,
# e o nock bloqueia saída de rede. Sem isto, a suíte só rodava em máquina que
# já tivesse um .env local, o que a tornava não reprodutível.
AWS_S3_BUCKET=bucket-de-teste
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-1

# OAuth do blog: a GoogleStrategy é instanciada no boot do AppModule e o
# passport-oauth2 recusa clientID vazio. Credenciais fictícias — nenhum fluxo
# OAuth é exercitado pela suíte.
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3999/blog/auth/google/callback
BLOG_DEFAULT_REDIRECT=http://localhost:3000

# IA do blog: o cliente é instanciado no boot e recusa apiKey vazia.
AI_API_KEY=test-ai-key
AI_USING=groq
