model Customer {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(255)
  searchName    String?    @db.VarChar(255)
  corporateName String     @db.VarChar(255)
  active        Boolean    @default(true)
  companyId     Int
  company       Company    @relation(fields: [companyId], references: [id])
  cnpj          String     @db.VarChar(14)
  imageUrl      String?    @db.VarChar(255)
  description   String?    @db.VarChar(255)
  rankId        Int
  rank          DOM_Ranks  @relation(fields: [rankId], references: [id])
  phone         String     @db.VarChar(100)
  email         String     @db.VarChar(255)
  stateId       Int
  state         DOM_States @relation(fields: [stateId], references: [id])
  cityId        Int
  city          DOM_Cities @relation(fields: [cityId], references: [id])
  neighborhood  String?    @db.VarChar(255)
  street        String?    @db.VarChar(255)
  number        Int?
  complement    String?    @db.VarChar(255)
  zipcode       String?    @db.VarChar(10)
  // dados fiscais: inscrição estadual (ou "ISENTO"), municipal e se contribui com ICMS
  stateRegistration     String? @db.VarChar(30)
  municipalRegistration String? @db.VarChar(30)
  icmsContributor       Boolean @default(false)
  // ramo: Prestação de Serviços, Industrial, Comercial, Construção Civil, Órgão Público...
  activityType          String? @db.VarChar(60)
  // CNAE principal ("código descrição") e optante do Simples Nacional
  cnae                  String? @db.VarChar(255)
  simplesNacional       Boolean @default(false)
  // segundo telefone (fixo, fax ou outro celular)
  phone2                String? @db.VarChar(100)
  // ponto no mapa: calculado pelo endereço (geocodedAt preenchido) ou ajustado à mão (geocodedAt vazio)
  latitude      Float?
  longitude     Float?
  geocodedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  inactiveAt    DateTime?

  contacts         Customer_Contacts[]
  classes          CourseClass[]
  trainees         Trainee[]
  financialRecords FinancialRecords[]
  proposals        Commercial_Proposal[]
  contracts        Commercial_Contract[]
  subscriptions    CourseClassSubscription[]
  reservations     CourseClassReservation[]

  @@unique([cnpj, companyId]) // Garante que o email seja único dentro da mesma empresa
}
