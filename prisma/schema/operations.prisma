// Operação: ordem de serviço (a obra que nasce de uma proposta de serviço aceita)
// e o histórico de passagens entre etapas, comum às esteiras do sistema.

enum ServiceOrderStatus {
  a_liberar
  a_mobilizar
  agendada
  em_execucao
  concluida
  encerrada
  cancelada
}

model Service_Order {
  id        Int    @id @default(autoincrement())
  companyId Int
  // OS-2026-0001
  number    String @db.VarChar(30)
  year      Int
  sequence  Int

  // a venda fechada (contrato) e a proposta de onde veio
  contractId Int @unique
  proposalId Int
  customerId Int

  title       String             @db.VarChar(200)
  description String?
  status      ServiceOrderStatus @default(a_liberar)

  contactName  String? @db.VarChar(160)
  contactPhone String? @db.VarChar(60)
  contactEmail String? @db.VarChar(255)
  location     String? @db.VarChar(300)
  // ponto próprio da obra no mapa (outra planta, outro município); sem ele, vale o ponto do cliente
  latitude     Float?
  longitude    Float?
  // quando a obra é num local da empresa (CT, base)
  placeId      Int?

  responsibleUserId Int?
  // equipe escalada: [{ name, role }]
  team Json?

  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  startedAt    DateTime? @db.Date
  finishedAt   DateTime? @db.Date

  // o que foi vendido, sem preço: [{ title, kind, items: [{ type, description, unit, quantity, ... }] }]
  scope     Json
  // cronograma da proposta (o planejado)
  schedule  Json?
  // custo orçado por grupo e receita: só aparece para quem vê custos
  budget    Json?
  // conferência da mobilização: [{ id, title, done, doneAt, doneBy }]
  checklist Json

  notes           String?
  conclusionNotes String?
  statusNote      String? @db.VarChar(500)
  // resultado (orçado × realizado) congelado ao encerrar a OS
  result          Json?
  closedAt        DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])

  payables Financial_Payable[]
}

// Histórico de passagens de qualquer esteira (ordem de serviço, depois compras e pagar).
model Flow_Event {
  id        Int     @id @default(autoincrement())
  companyId Int
  // "service_order", ...
  entity    String  @db.VarChar(40)
  entityId  Int
  type      String  @db.VarChar(40)
  fromStage String? @db.VarChar(40)
  toStage   String? @db.VarChar(40)
  userId    Int?
  note      String? @db.VarChar(1000)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// RDO — relatório diário de obra: um por dia e turno de cada ordem de serviço.
model Service_DailyReport {
  id        Int      @id @default(autoincrement())
  companyId Int
  orderId   Int
  date      DateTime @db.Date
  // integral | manha | tarde | noite
  shift     String   @default("integral") @db.VarChar(12)
  // bom | nublado | chuva | impraticavel
  weather   String   @default("bom") @db.VarChar(16)
  // rascunho | fechado
  status    String   @default("rascunho") @db.VarChar(12)

  // entrada na atividade e saída (HH:MM); `weather` é o clima na entrada
  startTime      String? @db.VarChar(5)
  endTime        String? @db.VarChar(5)
  // intervalo descontado das horas de quem ficou a jornada inteira
  breakMinutes   Int     @default(60)
  weatherEnd     String? @db.VarChar(16)
  // condição da frente de trabalho na entrada e na saída: normal | restricao | impedido
  startCondition String? @db.VarChar(12)
  endCondition   String? @db.VarChar(12)
  startNote      String? @db.VarChar(500)
  endNote        String? @db.VarChar(500)

  // equipe do dia: [{ name, role, hours, overtime, in?, out?, leaveReason? }] (in/out só quando diferem do dia)
  crew        Json
  // o que foi feito no dia
  activities  String?
  // avanço acumulado de cada etapa do cronograma: [{ step, title, percent }]
  progress    Json
  // [{ type, description, hoursLost }]
  occurrences Json
  equipment   String?
  // [{ url, caption }]
  photos      Json
  notes       String?

  createdByUserId Int?
  closedAt        DateTime?
  closedByUserId  Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([orderId, date, shift])
  @@index([companyId, orderId])
  @@index([companyId, date])
}

// Pedido de compra: compra, locação ou contratação de terceiros, para uma OS ou
// para a empresa. Solicitado → Aprovado → Comprado → Recebido (ou recusado/cancelado).
// Aprovado já conta como comprometido na OS; comprar gera as contas a pagar.
model Purchase_Order {
  id        Int    @id @default(autoincrement())
  companyId Int
  // PDC-2026-0001 (PC- já é o prefixo das propostas)
  number    String @db.VarChar(30)
  year      Int
  sequence  Int

  title  String @db.VarChar(200)
  // material | locacao | terceiros | outros
  group  String @db.VarChar(20)
  // solicitado | aprovado | comprado | recebido | recusado | cancelado
  status String @default("solicitado") @db.VarChar(20)

  supplierId     Int?
  serviceOrderId Int?

  // [{ description, unit, quantity, unitPrice, total }]
  items Json
  total Decimal @db.Decimal(18, 2)

  justification String?
  // para quando precisa chegar e o prazo combinado com o fornecedor
  neededBy     DateTime? @db.Date
  deliveryDate DateTime? @db.Date
  // condição de pagamento fechada na compra: { count, firstDueDate, method }
  paymentTerms Json?
  // [{ id, kind: cotacao | nota | outro, name, url }]
  attachments  Json

  invoiceNumber String? @db.VarChar(60)
  statusNote    String? @db.VarChar(500)

  requestedByUserId Int?
  approvedByUserId  Int?
  approvedAt        DateTime?
  purchasedAt       DateTime? @db.Date
  receivedAt        DateTime? @db.Date

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, serviceOrderId])
  @@index([companyId, supplierId])
}
