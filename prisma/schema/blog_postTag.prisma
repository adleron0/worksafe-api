// Tabela Blog_PostTag - Relação N:N entre Post e Tag
model Blog_PostTag {
  postId Int
  post   Blog_Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  Int
  tag    Blog_Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, tagId])
}
