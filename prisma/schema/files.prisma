// Arquivos da empresa: pastas livres em árvore e os arquivos dentro delas.
// O arquivo fica no armazenamento privado: aqui só o caminho (`fileKey`), nunca
// uma URL. Apagar manda para a lixeira (`trashedAt`); só depois de 30 dias, ou
// por ação de quem administra, a linha e o arquivo somem de verdade.

model File_Folder {
  id        Int    @id @default(autoincrement())
  companyId Int
  // pasta de cima; vazio = primeiro nível
  parentId  Int?
  parent    File_Folder?  @relation("File_FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  File_Folder[] @relation("File_FolderTree")

  name String @db.VarChar(120)

  // falso = todos que usam o módulo; verdadeiro = só os perfis de `profileIds`.
  // As pastas de dentro seguem a de cima (podem fechar mais, nunca abrir).
  restricted Boolean @default(false)
  profileIds Json?

  files File_Item[]

  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  trashedAt       DateTime?
  trashedByUserId Int?

  @@index([companyId, parentId])
}

model File_Item {
  id        Int         @id @default(autoincrement())
  companyId Int
  folderId  Int
  folder    File_Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // o nome mostrado (pode ser trocado) e o nome original do arquivo enviado
  name     String @db.VarChar(200)
  fileName String @db.VarChar(200)
  // files/<empresa>/<uuid>.<ext>: sem nome de arquivo nem de pasta
  fileKey  String @db.VarChar(300)
  mimeType String @db.VarChar(150)
  size     BigInt
  notes    String? @db.VarChar(500)

  // vencimento (opcional): direto no arquivo ou sugerido pelo tipo de documento
  typeId     Int?
  type       File_DocumentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  issueDate  DateTime?          @db.Date
  expiryDate DateTime?          @db.Date
  // dias de aviso deste arquivo; vazio = o do tipo (ou 30)
  warnDays   Int?

  // versões: substituir cria uma linha nova e marca a anterior (`replacedAt`);
  // todas as versões do mesmo arquivo levam o mesmo `versionGroup`
  versionGroup String?   @db.VarChar(36)
  replacedAt   DateTime?

  // envio direto em partes ainda não concluído: a linha existe, mas não aparece
  // em lugar nenhum até o envio fechar. `replacesId` é o arquivo que ela vai
  // substituir quando fechar (versão nova de um arquivo grande).
  uploadId   String? @db.VarChar(300)
  replacesId Int?

  uploadedByUserId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  trashedAt        DateTime?
  trashedByUserId  Int?

  @@index([companyId, folderId])
  @@index([companyId, trashedAt])
  @@index([companyId, expiryDate])
  @@index([versionGroup])
}

// Tipos de documento da empresa (alvará, PGR, certidões...): sugerem a validade
// e, quando obrigatórios, acusam "faltando" enquanto não houver um arquivo vigente.
model File_DocumentType {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String @db.VarChar(120)

  expires        Boolean @default(false)
  // validade sugerida ao informar a emissão (o vencimento pode ser corrigido)
  validityMonths Int?
  // com quantos dias de antecedência avisar
  warnDays       Int     @default(30)
  required       Boolean @default(false)

  files File_Item[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}
