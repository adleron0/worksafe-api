enum SubscribeStatus {
  pending
  confirmed
  declined
}

model CourseClassSubscription {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(100)
  cpf               String          @db.VarChar(20)
  email             String          @db.VarChar(255)
  phone             String          @db.VarChar(255)
  workedAt          String?         @db.VarChar(255)
  occupation        String?         @db.VarChar(255)
  companyId         Int?
  classId           Int?
  class             CourseClass?    @relation(fields: [classId], references: [id])
  traineeId         Int?
  trainee           Trainee?        @relation(fields: [traineeId], references: [id])
  subscribeStatus   SubscribeStatus @default(pending)
  confirmedAt       DateTime?
  declinedReason    String?
  address           String?         @db.VarChar(255)
  addressNumber     String?         @db.VarChar(255)
  addressComplement String?         @db.VarChar(255)
  neighborhood      String?         @db.VarChar(255)
  city              String?         @db.VarChar(255)
  state             String?         @db.VarChar(255)
  zipCode           String?         @db.VarChar(255)

  financialRecords FinancialRecords[]

  // Origem da inscrição pela página da turma (teste A/B). Só informativo:
  // não participa de pagamento, cupom, quota ou confirmação.
  landingLayout  String? @db.VarChar(20)
  landingVisitor String? @db.VarChar(40)
  landingOption  String? @db.VarChar(120) // opção escolhida no formulário (ex.: N1)
  utmSource      String? @db.VarChar(120)
  utmMedium      String? @db.VarChar(120)
  utmCampaign    String? @db.VarChar(120)
  referrer       String? @db.VarChar(255)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  // ÍNDICES ESSENCIAIS
  @@index([cpf]) // Busca por CPF
  @@index([email]) // Busca por email
  @@index([classId, subscribeStatus]) // Inscritos por turma
  @@index([traineeId]) // Inscrições do aluno
  @@index([companyId, subscribeStatus]) // Dashboard empresa
  @@index([createdAt]) // Ordenação temporal
  @@index([phone]) // Busca por telefone
  @@index([classId, landingLayout]) // Inscrições por layout da página
}
