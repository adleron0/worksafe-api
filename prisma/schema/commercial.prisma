// Comercial — base de cálculo de preços (substitui as abas CALC e MDO da
// planilha FORM-COM-001). Nada aqui é imposto: o motor só sugere valores.
//
// Tudo que é percentual de lei mora em tabela com data de vigência
// (`effectiveFrom`): virar o cálculo é cadastrar uma versão nova, não mexer
// em código.

enum CommercialCostItemGroup {
  encargo // % sobre o salário (resultado B)
  pessoal_indireto // cargos administrativos rateados (resultado D)
  outro_custo // custos mensais rateados (resultado E)
}

enum CommercialCostItemKind {
  fixo // rateado pelo efetivo (como a planilha faz com tudo)
  por_pessoa // R$ por homem/mês: não muda com o efetivo
}

enum CommercialTaxRegime {
  tradicional // tudo dentro do DAS, "por dentro" do preço
  hibrido // IBS/CBS fora do DAS, destacados "por fora"
}

enum CommercialTaxMode {
  nominal // alíquota da faixa (o que a planilha usa)
  efetiva // (RBT12 × alíquota − parcela a deduzir) ÷ RBT12
  manual
}

// Uma versão da base de custos. Vale a de maior `effectiveFrom` que não
// passa da data de referência.
model Commercial_CostBase {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String   @db.VarChar(120)
  effectiveFrom DateTime @db.Date
  notes         String?  @db.VarChar(500)

  // A — horas produtivas
  daysInYear    Int     @default(365)
  restDays      Int     @default(88)
  vacationDays  Int     @default(30)
  holidays      Int     @default(15)
  hoursPerDay   Decimal @default(8) @db.Decimal(6, 2)
  idleRate      Decimal @default(0.1) @db.Decimal(7, 6)
  monthsDivisor Int     @default(11)

  // Adicionais (base horária = salário ÷ additionalDivisor)
  weeklyHours       Decimal @default(44) @db.Decimal(6, 2)
  additionalDivisor Decimal @default(220) @db.Decimal(8, 2)
  nightRate         Decimal @default(0.2) @db.Decimal(7, 6)
  travelRate        Decimal @default(0.25) @db.Decimal(7, 6)
  weekendRate       Decimal @default(2) @db.Decimal(7, 6)
  // hora extra em dia normal (50% = hora × 1,5)
  overtimeRate      Decimal @default(0.5) @db.Decimal(7, 6)
  // false = igual à planilha (adicional de FDS não multiplica pela quantidade)
  weekendPerWorker  Boolean @default(false)

  // C — benefícios por hora
  mealPerDay        Decimal @default(0) @db.Decimal(12, 2)
  transportFare     Decimal @default(0) @db.Decimal(12, 2)
  transportTrips    Decimal @default(6) @db.Decimal(6, 2)
  // parte da passagem que NÃO entra no custo (a planilha usa 60%)
  transportDiscount Decimal @default(0.6) @db.Decimal(7, 6)
  // F — desconto de vale-transporte sobre o salário
  fareDiscountRate  Decimal @default(0.06) @db.Decimal(7, 6)

  // Efetivo médio em campo: divide D e E
  headcount Decimal @default(1) @db.Decimal(8, 2)

  // Padrões da proposta: margens por seção, níveis de imprevisibilidade,
  // comissão. JSON porque só o motor e a tela leem.
  defaults Json

  items Commercial_CostBaseItem[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, effectiveFrom])
}

model Commercial_CostBaseItem {
  id          Int                     @id @default(autoincrement())
  companyId   Int
  costBaseId  Int
  costBase    Commercial_CostBase     @relation(fields: [costBaseId], references: [id], onDelete: Cascade)
  group       CommercialCostItemGroup
  subgroup    String?                 @db.VarChar(80)
  name        String                  @db.VarChar(160)
  // encargo: fração do salário (0.08 = 8%)
  rate        Decimal?                @db.Decimal(9, 6)
  // pessoal_indireto: salário; outro_custo: R$/mês
  amount      Decimal?                @db.Decimal(14, 2)
  quantity    Decimal                 @default(1) @db.Decimal(8, 2)
  // pessoal_indireto: aplica (1 + B)? Pró-labore entra sem encargos.
  withCharges Boolean                 @default(true)
  kind        CommercialCostItemKind  @default(fixo)
  // Dívida (empréstimo, imposto atrasado): aparece separada no custo hora e
  // sai sozinha do cálculo depois de `endsAt`.
  isDebt      Boolean                 @default(false)
  endsAt      DateTime?               @db.Date
  order       Int                     @default(0)

  @@index([costBaseId, group])
}

// Tabela MDO: só nome e salário. Custo hora e adicionais são calculados.
model Commercial_Professional {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String  @db.VarChar(120)
  salary    Decimal @db.Decimal(12, 2)
  notes     String? @db.VarChar(255)

  // funcionários que exercem esta função (RH)
  employees Hr_EmployeeRole[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}

// Perfil tributário com vigência. `isDefault` é a chave "tradicional ⟷
// híbrido": no máximo um padrão por empresa.
model Commercial_TaxProfile {
  id            Int                 @id @default(autoincrement())
  companyId     Int
  name          String              @db.VarChar(120)
  regime        CommercialTaxRegime @default(tradicional)
  effectiveFrom DateTime            @db.Date
  mode          CommercialTaxMode   @default(nominal)
  rbt12         Decimal             @default(0) @db.Decimal(14, 2)
  manualRate    Decimal?            @db.Decimal(7, 6)
  // Parte do DAS que é IBS/CBS: sai da guia no híbrido e é o crédito do
  // cliente no tradicional.
  ibsCbsShare   Decimal             @default(0) @db.Decimal(7, 6)
  // CBS + IBS cheios, por fora (só no híbrido)
  outsideRate   Decimal             @default(0) @db.Decimal(7, 6)
  // [{ limit, rate, deduction }] em ordem crescente de limite
  brackets      Json
  // Locação de bens móveis (sem ISS no Simples: Anexo III menos a parcela do
  // ISS). Nulo = a mesma do serviço, até o contador confirmar o número.
  rentalRate        Decimal? @db.Decimal(7, 6)
  // no híbrido: CBS + IBS por fora da locação; nulo = o mesmo do serviço
  rentalOutsideRate Decimal? @db.Decimal(7, 6)
  isDefault     Boolean             @default(false)
  notes         String?             @db.VarChar(500)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, effectiveFrom])
}

// ---------------------------------------------------------------- propostas

// O tipo decide o que nasce do aceite: serviço → OS, treinamento → turma(s)
// fechada(s), locação → ordem de locação (Stock_Rental).
enum CommercialProposalKind {
  servico
  treinamento
  locacao
}

enum CommercialProposalStatus {
  rascunho
  enviada
  visualizada
  aceita
  recusada
  expirada
  cancelada
  substituida // existe uma revisão mais nova
}

enum CommercialItemType {
  mao_de_obra
  locacao
  material
  treinamento
  avulso
  // equipamento próprio alugado ao cliente (estoque); `locacao` é o aluguel que a empresa paga
  locacao_cliente
}

enum CommercialDueRule {
  data_fixa
  dias_apos_aceite
  dias_apos_nf
  dias_apos_conclusao
  // ao atingir `workPercent`% de avanço da obra (RDO fechado); só referência, nunca trava
  percentual_obra
}

// Tabela de preço in-company de um curso (sugestão para itens de
// treinamento). Fica fora de `Course` de propósito: a listagem de cursos é
// pública (site) e não deve carregar preço de proposta.
model Commercial_CoursePrice {
  id               Int      @id @default(autoincrement())
  companyId        Int
  courseId         Int
  // preço de uma turma fechada, que já inclui `includedStudents` alunos
  classPrice       Decimal? @db.Decimal(12, 2)
  includedStudents Int?
  // por aluno (se não há preço de turma) ou por aluno além dos incluídos
  studentPrice     Decimal? @db.Decimal(12, 2)
  notes            String?  @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([companyId, courseId])
}

// Uma proposta (ou uma revisão dela). Serviço e treinamento são a mesma
// coisa: muda só o tipo dos itens.
model Commercial_Proposal {
  id        Int                      @id @default(autoincrement())
  companyId Int
  // PC-2026-0001 (revisões: PC-2026-0001-R1)
  number    String                   @db.VarChar(30)
  year      Int
  sequence  Int
  revision  Int                      @default(0)
  // primeira versão da proposta; nulo nela mesma
  rootId    Int?
  kind      CommercialProposalKind   @default(servico)
  status    CommercialProposalStatus @default(rascunho)

  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactName  String?  @db.VarChar(160)
  contactEmail String?  @db.VarChar(255)
  contactPhone String?  @db.VarChar(60)
  requester    String?  @db.VarChar(160)
  department   String?  @db.VarChar(160)
  title        String   @db.VarChar(200)
  description  String?
  sellerId     Int?

  validUntil    DateTime? @db.Date
  // data prevista do serviço/faturamento: escolhe a base e o imposto vigentes
  referenceDate DateTime  @db.Date
  workDays      Int       @default(0)
  weekendDays   Int       @default(0)

  contingencyRate   Decimal              @default(0) @db.Decimal(7, 6)
  commissionRate    Decimal              @default(0) @db.Decimal(7, 6)
  commissionBase    String               @default("faturado") @db.VarChar(20)
  commissionInPrice Boolean              @default(false)
  // nulo = a versão da base vigente na data prevista; preenchido = base escolhida à mão
  costBaseId        Int?
  // nulo = regime padrão da empresa na data
  taxRegime         CommercialTaxRegime?
  // desconto em R$ sobre o preço líquido
  discount          Decimal              @default(0) @db.Decimal(14, 2)
  // negociação (agrupa propostas do mesmo cliente) e a parte desta proposta no desconto de fechamento conjunto
  dealId            Int?
  dealDiscount      Decimal              @default(0) @db.Decimal(14, 2)

  // Fotografia da base e do imposto usados: mudar a configuração depois não
  // altera a proposta (rascunho pode pedir para recalcular).
  snapshot Json

  // Proposta de locação: período, nº de períodos ou "até devolver", cobrança
  // (por período ou única), caução e endereço de entrega. Nulo nos outros tipos.
  rental Json?

  // Faturamento da proposta de serviço: parcelas (padrão) ou medição de obra.
  // { mode: parcelas|medicao, fronts: [{ step, title, weight, rule: percentual|conclusao }],
  //   mobilization: { mode: nenhuma|etapa|adiantamento, rate }, depositRate, depositReleaseDays }
  measurement Json?
  // caução contratual (parcelas): fração retida de cada nota e dias após a conclusão para liberar
  depositRate        Decimal @default(0) @db.Decimal(7, 6)
  depositReleaseDays Int     @default(0)

  totalCost      Decimal @default(0) @db.Decimal(14, 2)
  totalSuggested Decimal @default(0) @db.Decimal(14, 2)
  totalNet       Decimal @default(0) @db.Decimal(14, 2)
  totalTax       Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)
  profit         Decimal @default(0) @db.Decimal(14, 2)
  commission     Decimal @default(0) @db.Decimal(14, 2)

  internalNotes String?
  statusNote    String?   @db.VarChar(500)
  sentAt        DateTime?
  decidedAt     DateTime?

  createdByUserId Int?

  // Documento: cópia editável do modelo (com variáveis), termos escolhidos e
  // como a tabela de itens aparece. Ao enviar, o documento é congelado.
  templateId          Int?
  documentBody        String?
  itemsMode           String                     @default("detalhado") @db.VarChar(20)
  termIds             Int[]                      @default([])
  // link público: /proposta/<publicKey>
  publicKey           String?                    @unique @db.VarChar(40)
  frozenHtml          String?
  frozenHash          String?                    @db.VarChar(64)
  viewedAt            DateTime?
  // imagens da proposta: [{ url, title, description, annotations: [...] }]
  images              Json?
  // cronograma: { unit: dia|semana|mes, steps: [{ title, start, duration }] }
  schedule            Json?
  // código de confirmação do aceite (só o hash)
  acceptCodeHash      String?                    @db.VarChar(64)
  acceptCodeExpiresAt DateTime?
  acceptCodeAttempts  Int                        @default(0)
  events              Commercial_ProposalEvent[]

  sections     Commercial_ProposalSection[]
  items        Commercial_ProposalItem[]
  installments Commercial_ProposalInstallment[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([dealId])
  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, year, sequence])
}

model Commercial_ProposalSection {
  id             Int                       @id @default(autoincrement())
  companyId      Int
  proposalId     Int
  proposal       Commercial_Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  title          String                    @db.VarChar(120)
  // tipo de item que a seção oferece por padrão
  kind           CommercialItemType
  margin         Decimal                   @default(0) @db.Decimal(7, 6)
  order          Int                       @default(0)
  showInDocument Boolean                   @default(true)
  items          Commercial_ProposalItem[]

  @@index([proposalId])
}

model Commercial_ProposalItem {
  id          Int                        @id @default(autoincrement())
  companyId   Int
  proposalId  Int
  proposal    Commercial_Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  sectionId   Int
  section     Commercial_ProposalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        CommercialItemType
  description String                     @db.VarChar(300)
  unit        String?                    @db.VarChar(30)
  quantity    Decimal                    @default(1) @db.Decimal(12, 3)

  // mao_de_obra
  professionalId Int?
  night          Boolean  @default(false)
  travel         Boolean  @default(false)
  weekend        Boolean  @default(false)
  // próprios da linha; nulo = os do cabeçalho
  workDays       Int?
  weekendDays    Int?
  hoursPerDay    Decimal? @db.Decimal(6, 2)
  // horas extras por profissional da linha, no período todo
  overtimeHours  Decimal  @default(0) @db.Decimal(8, 2)

  // locacao_cliente: o item do estoque alugado (o período fica em `extra.period`)
  stockItemId Int?

  // treinamento
  courseId Int?
  // alunos, carga horária, datas, local
  extra    Json?

  // locação, material, avulso, treinamento: custo = qtd × unitário + taxas
  unitCost  Decimal  @default(0) @db.Decimal(14, 2)
  extraCost Decimal  @default(0) @db.Decimal(14, 2)
  // margem só deste item; nulo = a da seção
  margin    Decimal? @db.Decimal(7, 6)

  cost           Decimal  @default(0) @db.Decimal(14, 2)
  suggestedValue Decimal  @default(0) @db.Decimal(14, 2)
  // digitado; nulo = usa o sugerido
  finalValue     Decimal? @db.Decimal(14, 2)
  value          Decimal  @default(0) @db.Decimal(14, 2)

  order          Int     @default(0)
  showInDocument Boolean @default(true)

  @@index([proposalId])
  @@index([sectionId])
}

model Commercial_ProposalInstallment {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  proposalId  Int
  proposal    Commercial_Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  order       Int                 @default(0)
  // percentual do total OU valor fixo
  percent     Decimal?            @db.Decimal(7, 6)
  amount      Decimal?            @db.Decimal(14, 2)
  dueRule     CommercialDueRule   @default(dias_apos_nf)
  dueDate     DateTime?           @db.Date
  dueDays     Int?
  // vencimento `percentual_obra`: % de avanço da obra que libera a parcela (1–100)
  workPercent Decimal?            @db.Decimal(7, 4)
  description String?             @db.VarChar(200)

  @@index([proposalId])
}

// ---------------------------------------------------------------- documento e aceite

// Modelo de proposta: texto rico com variáveis ({{cliente.nome}}) e blocos
// ({{tabela_itens}}, {{condicoes_pagamento}}, {{termos}}, {{assinatura}}).
model Commercial_ProposalTemplate {
  id        Int                     @id @default(autoincrement())
  companyId Int
  name      String                  @db.VarChar(120)
  // nulo = serve para qualquer tipo de proposta
  kind      CommercialProposalKind?
  body      String
  itemsMode String                  @default("detalhado") @db.VarChar(20)
  termIds   Int[]                   @default([])
  isDefault Boolean                 @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId])
}

// Texto jurídico pré-cadastrado (aceite, pagamento, cancelamento, LGPD...).
model Commercial_Term {
  id        Int    @id @default(autoincrement())
  companyId Int
  title     String @db.VarChar(160)
  kind      String @default("geral") @db.VarChar(30)
  body      String
  order     Int    @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId])
}

// Trilha da proposta: enviada, visualizada, aceita, recusada... com as
// evidências do aceite (quem, quando, de onde, qual documento).
model Commercial_ProposalEvent {
  id           Int                 @id @default(autoincrement())
  companyId    Int
  proposalId   Int
  proposal     Commercial_Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  type         String              @db.VarChar(30)
  userId       Int?
  ip           String?             @db.VarChar(64)
  userAgent    String?             @db.VarChar(400)
  name         String?             @db.VarChar(160)
  cpf          String?             @db.VarChar(14)
  role         String?             @db.VarChar(120)
  email        String?             @db.VarChar(255)
  documentHash String?             @db.VarChar(64)
  // o código foi confirmado por e-mail?
  codeVerified Boolean?
  note         String?             @db.VarChar(1000)

  createdAt DateTime @default(now())

  @@index([proposalId])
}

// ---------------------------------------------------------------- contrato

enum CommercialContractStatus {
  vigente
  concluido
  cancelado
}

// Nasce do aceite da proposta: é a proposta aceita, congelada, com quem
// aceitou. As parcelas previstas viram contas a receber quando a nota fiscal
// de cada uma é registrada.
model Commercial_Contract {
  id           Int                      @id @default(autoincrement())
  companyId    Int
  // CT-2026-0001
  number       String                   @db.VarChar(30)
  year         Int
  sequence     Int
  proposalId   Int                      @unique
  customerId   Int
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kind         CommercialProposalKind
  status       CommercialContractStatus @default(vigente)
  title        String                   @db.VarChar(200)
  value        Decimal                  @db.Decimal(14, 2)
  acceptedAt   DateTime
  startDate    DateTime?                @db.Date
  endDate      DateTime?                @db.Date
  // documento aceito, como o cliente leu
  documentHtml String?
  documentHash String?                  @db.VarChar(64)
  // quem aceitou (nome, CPF, cargo, e-mail, IP...) ou o registro manual
  signer       Json?
  sellerId     Int?
  // itens de treinamento da proposta e as turmas fechadas criadas para eles
  classes      Json?
  notes        String?
  statusNote   String?                  @db.VarChar(500)
  // pedido de compra que o cliente manda para confirmar o aceite (vai na NF)
  customerOrderNumber   String?   @db.VarChar(60)
  customerOrderDate     DateTime? @db.Date
  customerOrderUrl      String?   @db.VarChar(500)
  customerOrderFileName String?   @db.VarChar(200)
  // parcelas (parcelas fixas da proposta) | periodo (locação: cada período vencido é uma medição)
  billingMode String @default("parcelas") @db.VarChar(10)
  // retenções que o cliente costuma fazer na nota, em %: { iss: 5, inss: 11, ... } (sugestão ao faturar)
  retentionRates Json?
  // medição de obra (billingMode = medicao): frentes com valor, mobilização e caução (copiado da proposta)
  measurementPlan Json?
  // caução contratual nas parcelas: fração retida de cada nota e dias após a conclusão para liberar
  depositRate        Decimal @default(0) @db.Decimal(7, 6)
  depositReleaseDays Int     @default(0)
  // conta a receber da caução contratual acumulada nos boletins (liberada no fim da obra)
  depositRecordId Int?

  installments Commercial_ContractInstallment[]
  measurements Commercial_Measurement[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model Commercial_ContractInstallment {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  contractId        Int
  contract          Commercial_Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number            Int
  total             Int
  description       String?             @db.VarChar(200)
  value             Decimal             @db.Decimal(14, 2)
  dueRule           CommercialDueRule
  dueDate           DateTime?           @db.Date
  dueDays           Int?
  workPercent       Decimal?            @db.Decimal(7, 4)
  // caução contratual retida na nota desta parcela (vai para a conta da caução do contrato)
  depositValue      Decimal?            @db.Decimal(14, 2)
  // conta a receber gerada ao registrar a nota fiscal desta parcela
  financialRecordId Int?                @unique
  billedAt          DateTime?

  @@index([contractId])
}

// Identidade usada nas propostas: frase, quem somos, números, diferenciais,
// depoimentos e contato. Logo e cor vêm do cadastro da empresa, salvo se
// definidos aqui.
model Commercial_Settings {
  id        Int      @id @default(autoincrement())
  companyId Int      @unique
  brand     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Carteira de comissões de um vendedor (um usuário marcado como vendedor).
/// O saldo nunca é guardado: sai sempre da soma dos lançamentos.
model Commercial_SellerWallet {
  id        Int                            @id @default(autoincrement())
  companyId Int
  userId    Int                            @unique
  entries   Commercial_SellerWalletEntry[]
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @default(now()) @updatedAt

  @@index([companyId])
}

/// Histórico da carteira: comissões (que nascem de uma conta a receber),
/// pagamentos ao vendedor (baixas) e ajustes manuais.
model Commercial_SellerWalletEntry {
  id          Int                     @id @default(autoincrement())
  companyId   Int
  walletId    Int
  wallet      Commercial_SellerWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  sellerId    Int
  /// comissao | pagamento | ajuste
  type        String                  @db.VarChar(20)
  /// treinamento | servico | manual
  origin      String                  @db.VarChar(20)
  /// comissão: prevista | liberada | cancelada · pagamento e ajuste: efetivado | estornado
  status      String                  @db.VarChar(20)
  /// com sinal: comissão e crédito positivos; pagamento e débito negativos
  amount      Decimal                 @db.Decimal(18, 2)
  /// sobre quanto a comissão foi calculada e o percentual (0–100)
  baseValue   Decimal?                @db.Decimal(18, 2)
  rate        Decimal?                @db.Decimal(7, 4)
  description String                  @db.VarChar(255)

  // de onde veio a comissão (um lançamento de comissão por conta a receber)
  financialRecordId     Int? @unique
  couponId              Int?
  classId               Int?
  subscriptionId        Int?
  proposalId            Int?
  contractId            Int?
  contractInstallmentId Int?

  /// data do fato: da venda (comissão), do pagamento ao vendedor ou do ajuste
  occurredAt DateTime
  /// quando a comissão entrou no saldo (o cliente pagou)
  releasedAt DateTime?

  // pagamento ao vendedor
  paymentMethod String? @db.VarChar(30)
  bankAccountId Int?
  receiptUrl    String? @db.VarChar(500)
  note          String? @db.VarChar(500)

  createdByUserId  Int?
  reversedAt       DateTime?
  reversedByUserId Int?
  reverseReason    String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId, sellerId, type, status])
  @@index([walletId, occurredAt])
  @@index([contractId])
}

// ---------------------------------------------------------------- acompanhamento

// Contato com o cliente: o que já aconteceu (ligação, mensagem, reunião) e o
// que está marcado (retorno, visita, tarefa). Feita = doneAt preenchido;
// pendente = dueDate sem doneAt; cancelada = inactiveAt.
model Commercial_Activity {
  id          Int     @id @default(autoincrement())
  companyId   Int
  customerId  Int
  // a proposta de onde o contato saiu (opcional: pode ser só com o cliente)
  proposalId  Int?
  // ligacao | whatsapp | email | reuniao | visita | tarefa | nota
  type        String  @db.VarChar(20)
  subject     String  @db.VarChar(200)
  notes       String?
  contactName String? @db.VarChar(160)

  // quando está marcada (dia e, se houver, hora "HH:MM", no horário de Brasília)
  dueDate DateTime? @db.Date
  dueTime String?   @db.VarChar(5)
  // quando aconteceu e o que ficou combinado
  doneAt  DateTime?
  result  String?   @db.VarChar(2000)

  // responsável
  userId          Int?
  createdByUserId Int?
  // lembrete automático de uma ordem de locação (fim de período, devolução)
  rentalId        Int?
  autoKey         String? @db.VarChar(60)
  // negociação de onde o contato saiu (opcional)
  dealId          Int?
  // conversa (WhatsApp/Instagram) de onde o contato saiu (opcional)
  chatConversationId Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, proposalId])
  @@index([companyId, customerId])
  @@index([companyId, doneAt, dueDate])
  @@index([rentalId])
  @@index([chatConversationId])
  @@unique([companyId, autoKey])
}

// ---------------------------------------------------------------- turma fechada × venda

/// De onde vem o dinheiro de uma turma fechada (turma com cliente): de uma
/// venda (contrato) ou de nenhuma, por decisão registrada (cortesia, interno).
/// Fica fora de `CourseClass` de propósito: a listagem de turmas é pública.
model Commercial_ClassBilling {
  id         Int      @id @default(autoincrement())
  companyId  Int
  classId    Int      @unique
  // contrato | sem_cobranca
  mode       String   @db.VarChar(20)
  contractId Int?
  reason     String?  @db.VarChar(300)
  userId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([companyId, mode])
  @@index([contractId])
}

// ---------------------------------------------------------------- faturamento por medição

/// Boletim de medição (BM-01, BM-02… por contrato): o que se fatura de uma vez
/// numa nota. Na locação é montado sozinho com os períodos vencidos, as avarias
/// e faltas e as cobranças avulsas da ordem de locação (origem "locacao"); a
/// medição de obra (plano 08, fase 8) usa a mesma tabela com origem "obra".
model Commercial_Measurement {
  id         Int      @id @default(autoincrement())
  companyId  Int
  contractId Int
  contract   Commercial_Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // sequência dentro do contrato
  number     Int
  // locacao | obra
  source     String   @db.VarChar(10)
  rentalId   Int?
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  value      Decimal  @db.Decimal(14, 2)
  // valor da nota fiscal do boletim (base das retenções de imposto); nulo = o próprio `value`
  invoiceValue Decimal? @db.Decimal(14, 2)
  // linhas: [{ kind, description, periodStart, periodEnd, value, chargeId }]
  lines      Json
  // locação: faturada | cancelada; obra: rascunho → enviada → aprovada (ou contestada) → faturada
  status     String   @default("faturada") @db.VarChar(12)
  // obra: caução contratual retida neste boletim (vai para a conta da caução)
  depositValue Decimal? @db.Decimal(14, 2)
  notes        String?  @db.VarChar(2000)
  // link do cliente para aprovar o boletim: /medicao/<publicKey>
  publicKey    String?  @unique @db.VarChar(40)
  sentAt       DateTime?
  decidedAt    DateTime?
  // quem aprovou ou contestou: { name, role, note, ip, userAgent, at, manual, userId }
  decision     Json?
  financialRecordId Int?
  invoiceNumber     String? @db.VarChar(60)
  createdByUserId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([contractId])
  @@index([rentalId])
}

// ---------------------------------------------------------------- negociação

/// Negociação (NG-2026-0001): agrupa propostas do mesmo cliente (serviço, locação,
/// treinamento), cada uma com o seu destino e a sua NF. A situação é calculada
/// pelas propostas. O desconto de fechamento conjunto (desligado por padrão) é
/// rateado entre as propostas e gravado no `dealDiscount` de cada uma.
model Commercial_Deal {
  id         Int     @id @default(autoincrement())
  companyId  Int
  number     String  @db.VarChar(30)
  year       Int
  sequence   Int
  customerId Int
  title      String  @db.VarChar(200)
  sellerId   Int?
  notes      String?

  // desconto de fechamento conjunto
  discountEnabled   Boolean @default(false)
  // percentual (discountValue = fração 0–1) | valor (R$)
  discountType      String  @default("percentual") @db.VarChar(12)
  discountValue     Decimal @default(0) @db.Decimal(14, 4)
  // proporcional (ao valor de cada proposta) | igual | manual (valor por proposta)
  discountSplit     String  @default("proporcional") @db.VarChar(12)
  // manual: { "<proposalId>": valor }
  discountManual    Json?
  // propostas que recebem o desconto (vazio = todas as da negociação)
  discountTargets   Int[]   @default([])
  // incondicional | todas (só se fechar todas) | marcadas (só se fechar as marcadas)
  discountCondition String  @default("incondicional") @db.VarChar(14)
  requiredIds       Int[]   @default([])
  // o que fazer quando a condição cai: avisar | recalcular | retirar
  onBreak           String  @default("avisar") @db.VarChar(12)
  // condição descumprida: { at, reason, lost: [ids], action, pending: [ids] } (nulo = ok)
  breach            Json?
  discountAppliedAt DateTime?

  // link único para o cliente ver as propostas da negociação
  publicKey  String?  @unique @db.VarChar(64)

  createdByUserId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, number])
  @@index([companyId, customerId])
}
