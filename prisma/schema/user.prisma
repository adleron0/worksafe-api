model User {
  id               Int                      @id @default(autoincrement())
  name             String                   @db.VarChar(255)
  searchName       String?                  @db.VarChar(255)
  active           Boolean                  @default(true)
  email            String                   @db.VarChar(255)
  password         String                   @db.VarChar(255)
  imageUrl         String?                  @db.VarChar(255)
  phone            String                   @db.VarChar(255)
  cpf              String                   @db.VarChar(20)
  /// identificador fixo da conta Google (claim `sub`); o vínculo é por ele, não pelo e-mail
  googleSub        String?                  @unique @db.VarChar(64)
  /// convidado externo: acesso vale até esta data (nulo = da casa)
  externalUntil    DateTime?
  birthDate        DateTime?
  companyId        Int?
  company          Company?                 @relation(fields: [companyId], references: [id])
  profileId        Int?
  profile          Profile?                 @relation(fields: [profileId], references: [id])
  permissions      UserPermission[] // Relacionamento com UserPermission
  sessions         Session[] // Relacionamento com Session
  systemLogs       System_Logs[] // Relacionamento com System_Logs
  confinusRegister Confinus_ConfinedSpace[] @relation("RegisteredByUser")
  confinusApprove  Confinus_ConfinedSpace[] @relation("ApprovedByUser")
  isSeller        Boolean                  @default(false)
  sellerStatus    sellerStatusTypes        @default(PENDING)
  sellerConfig    Json?
  /// comissão própria do vendedor nas propostas (nula = usa o padrão da base de cálculo)
  commissionRate  Decimal?                 @db.Decimal(6, 4)
  /// base da comissão própria: 'lucro' ou 'faturado'
  commissionBase  String?                  @db.VarChar(20)
  bankAccount    Json?
  address           String?         @db.VarChar(255)
  addressNumber     String?         @db.VarChar(255)
  addressComplement String?         @db.VarChar(255)
  neighborhood      String?         @db.VarChar(255)
  city              String?         @db.VarChar(255)
  state             String?         @db.VarChar(255)
  zipCode           String?         @db.VarChar(255)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?
  sellerActivatedAt DateTime?
  financialRecords FinancialRecords[]  // Registros financeiros associados ao seller
  coupons          Coupon[]            // Cupons associados ao seller
  splitTransactions SplitTransaction[] // Transações de split associadas ao seller
  blogPosts        Blog_Post[]         // Posts do blog criados pelo usuário
  blogVisitors     Blog_Visitor[]      // Visitantes vinculados a este usuário (mesmo email)
  accessRequests   AccessRequest[]     @relation("AccessRequestUser")
  accessDecisions  AccessRequest[]     @relation("AccessRequestDecider")
  externalInvite   ExternalInvite?     @relation("ExternalInviteUser")
  invitesSent      ExternalInvite[]    @relation("ExternalInviteBy")

  @@unique([email, companyId]) // Garante que o email seja único dentro da mesma empresa
  @@unique([id, companyId]) // Índice composto para id e companyId
}
