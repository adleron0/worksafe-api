// RH: cadastro de funcionários, as funções de cada um e o histórico
// (férias, afastamento, suspensão, advertência, desligamento).
//
// A situação do funcionário não é gravada: sai do histórico na leitura.
// Só entra aqui o que a operação e a integração de obra pedem; salário, dados
// bancários, endereço e dados de saúde ficam de fora de propósito.

model Hr_Employee {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String @db.VarChar(160)

  // dados pessoais: só aparecem para quem tem view_dados_pessoais_funcionarios
  // CPF só dígitos
  cpf            String?   @db.VarChar(11)
  rg             String?   @db.VarChar(30)
  birthDate      DateTime? @db.Date
  email          String?   @db.VarChar(160)
  emergencyName  String?   @db.VarChar(120)
  emergencyPhone String?   @db.VarChar(30)

  phone        String? @db.VarChar(30)
  // matrícula
  registration String? @db.VarChar(30)
  // clt | pj | temporario | estagio
  contractType String  @default("clt") @db.VarChar(12)

  admissionDate   DateTime? @db.Date
  // preenchida pelo registro de desligamento do histórico
  terminationDate DateTime? @db.Date

  // usuário do sistema, quando a pessoa tem login (um usuário para no máximo um funcionário)
  userId Int?    @unique
  notes  String? @db.VarChar(1000)

  roles     Hr_EmployeeRole[]
  events    Hr_EmployeeEvent[]
  documents  Hr_EmployeeDocument[]
  activities Hr_ActivityEmployee[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, cpf])
  @@index([companyId, name])
}

// Funções que a pessoa exerce: as mesmas da base de cálculo do Comercial, para
// o custo de mão de obra do RDO casar pelo cadastro.
model Hr_EmployeeRole {
  id             Int                     @id @default(autoincrement())
  employeeId     Int
  employee       Hr_Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  professionalId Int
  professional   Commercial_Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  isPrimary      Boolean                 @default(false)

  createdAt DateTime @default(now())

  @@unique([employeeId, professionalId])
  @@index([professionalId])
}

// Histórico do funcionário. Férias, afastamento e suspensão têm período e
// definem a situação; advertência e mudança de função têm só a data;
// desligamento grava a data no funcionário.
model Hr_EmployeeEvent {
  id         Int         @id @default(autoincrement())
  companyId  Int
  employeeId Int
  employee   Hr_Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // ferias | afastamento | suspensao | advertencia | desligamento | mudanca_funcao
  type       String      @db.VarChar(20)
  startDate  DateTime    @db.Date
  endDate    DateTime?   @db.Date
  reason     String?     @db.VarChar(1000)

  createdByUserId Int?
  createdAt       DateTime  @default(now())
  inactiveAt      DateTime?

  @@index([employeeId, startDate])
  @@index([companyId, type, startDate])
}

// Tipos de documento do funcionário (ASO, NR-35, CNH...): em que pasta fica,
// se vence, a validade sugerida e se é obrigatório ou entra na integração de obra.
model Hr_DocumentType {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String @db.VarChar(120)
  // admissao | saude | treinamentos | pessoais | outros
  folder    String @default("outros") @db.VarChar(20)

  expires        Boolean @default(false)
  // validade sugerida ao enviar (o vencimento pode ser corrigido)
  validityMonths Int?
  // com quantos dias de antecedência avisar
  warnDays       Int     @default(30)
  required       Boolean @default(false)
  // funções para as quais é obrigatório: [professionalId]; vazio = todos
  requiredProfessionalIds Json?
  // entra no pacote de documentos para a integração de obra
  inIntegration  Boolean @default(false)

  documents Hr_EmployeeDocument[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}

// O arquivo de um documento. Fica no armazenamento privado: aqui só o caminho
// (`fileKey`), nunca uma URL. Substituir guarda a versão anterior (`replacedAt`).
model Hr_EmployeeDocument {
  id         Int             @id @default(autoincrement())
  companyId  Int
  employeeId Int
  employee   Hr_Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId     Int
  type       Hr_DocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  issueDate  DateTime? @db.Date
  expiryDate DateTime? @db.Date

  fileKey  String  @db.VarChar(300)
  fileName String  @db.VarChar(200)
  mimeType String  @db.VarChar(100)
  size     Int
  notes    String? @db.VarChar(500)

  uploadedByUserId Int?
  // preenchido quando uma versão nova do mesmo tipo entra
  replacedAt       DateTime?

  createdAt  DateTime  @default(now())
  inactiveAt DateTime?

  @@index([companyId, expiryDate])
  @@index([employeeId, typeId])
}

// Tipos de atividade fora de OS (aula, treinamento, atividade no CT, deslocamento...).
// `occupies`: se a pessoa conta como ocupada para escala enquanto está nela.
model Hr_ActivityType {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String  @db.VarChar(80)
  // cor da barra na linha do tempo (hexadecimal)
  color     String  @default("#0f766e") @db.VarChar(9)
  occupies  Boolean @default(true)

  activities Hr_Activity[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}

// Atividade fora de OS, de uma ou várias pessoas, num período e numa parte do dia.
// Junto com a equipe das OS, é de onde sai o mapa de alocação.
model Hr_Activity {
  id        Int             @id @default(autoincrement())
  companyId Int
  typeId    Int
  type      Hr_ActivityType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  // onde acontece: um local da empresa (CT, base) e/ou um texto livre
  placeId   Int?
  location  String?         @db.VarChar(200)
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  // integral | manha | tarde | noite
  shift     String          @default("integral") @db.VarChar(12)
  notes     String?         @db.VarChar(500)

  employees Hr_ActivityEmployee[]

  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  inactiveAt      DateTime?

  @@index([companyId, startDate, endDate])
}

model Hr_ActivityEmployee {
  id         Int         @id @default(autoincrement())
  activityId Int
  activity   Hr_Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Hr_Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([activityId, employeeId])
  @@index([employeeId])
}
