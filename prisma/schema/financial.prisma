// Cadastros do financeiro: plano de contas (conta mãe/filha), centros de
// custo e contas bancárias. Classificam os lançamentos de FinancialRecords.

enum ChartAccountNature {
  receita
  despesa
}

enum BankAccountType {
  corrente
  poupanca
  caixa
  gateway // saldo no provedor de pagamento (ex.: Asaas)
}

// Plano de contas em até 3 níveis. A hierarquia fica em `parentId` e também
// no `code` (1, 1.2, 1.2.3), gerado pela API. Só conta sem filhas
// (`acceptsEntries`) recebe lançamento.
model Financial_ChartAccount {
  id             Int                      @id @default(autoincrement())
  companyId      Int
  parentId       Int?
  parent         Financial_ChartAccount?  @relation("ChartAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Financial_ChartAccount[] @relation("ChartAccountTree")
  code           String                   @db.VarChar(20)
  name           String                   @db.VarChar(120)
  nature         ChartAccountNature
  level          Int
  acceptsEntries Boolean                  @default(true)
  dreGroup       String?                  @db.VarChar(40)
  // Raízes (1 Receitas, 2 Despesas): não editáveis nem inativáveis.
  isSystem       Boolean                  @default(false)

  financialRecords       FinancialRecords[]
  classificationDefaults Financial_ClassificationDefault[]

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model Financial_CostCenter {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(120)
  code        String? @db.VarChar(20)
  description String? @db.VarChar(255)

  financialRecords       FinancialRecords[]
  classificationDefaults Financial_ClassificationDefault[]

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}

model Financial_BankAccount {
  id                 Int             @id @default(autoincrement())
  companyId          Int
  name               String          @db.VarChar(120)
  type               BankAccountType @default(corrente)
  bankCode           String?         @db.VarChar(10)
  bankName           String?         @db.VarChar(120)
  agency             String?         @db.VarChar(20)
  agencyDigit        String?         @db.VarChar(5)
  account            String?         @db.VarChar(30)
  accountDigit       String?         @db.VarChar(5)
  pixKey             String?         @db.VarChar(140)
  holderName         String?         @db.VarChar(255)
  holderDocument     String?         @db.VarChar(20)
  openingBalance     Decimal         @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime?
  // Conta do tipo gateway: de qual provedor é o saldo.
  gateway            gateways?
  isDefault          Boolean         @default(false)

  financialRecords FinancialRecords[]

  payables Financial_Payable[]

  transfersOut Financial_Transfer[] @relation("TransferFrom")
  transfersIn  Financial_Transfer[] @relation("TransferTo")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
  statementDrafts Financial_StatementDraft[]
}

// Classificação que um recebível ganha sozinho conforme a origem
// (ex.: `inscricao` = checkout de turma). Editável em Financeiro.
model Financial_ClassificationDefault {
  id             Int                     @id @default(autoincrement())
  companyId      Int
  origin         String                  @db.VarChar(40)
  chartAccountId Int?
  chartAccount   Financial_ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)
  costCenterId   Int?
  costCenter     Financial_CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([companyId, origin])
}

// Fornecedores: de quem a empresa compra, aluga ou contrata. Cadastro simples,
// usado nas contas a pagar e (depois) nos pedidos de compra.
model Financial_Supplier {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(160)
  // razão social, quando o nome acima é o fantasia
  legalName   String? @db.VarChar(200)
  // CNPJ ou CPF, só dígitos
  document    String? @db.VarChar(14)
  // o que fornece (ex.: locação de andaimes)
  supplies    String? @db.VarChar(255)
  contactName String? @db.VarChar(120)
  email       String? @db.VarChar(160)
  phone       String? @db.VarChar(30)
  pixKey      String? @db.VarChar(140)
  bankName    String? @db.VarChar(120)
  agency      String? @db.VarChar(20)
  account     String? @db.VarChar(30)
  notes       String? @db.VarChar(500)
  // endereço em texto livre (fornecedor pode ser de qualquer lugar; número aceita "S/N")
  zipcode      String? @db.VarChar(10)
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(20)
  complement   String? @db.VarChar(255)
  neighborhood String? @db.VarChar(120)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(2)

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, name])
  @@index([companyId, document])
}

// Contas a pagar. Tabela separada dos recebíveis (FinancialRecords é presa a
// cliente, aluno e gateway). "Atrasada" não é situação gravada: é conta aberta
// com vencimento passado, calculada na leitura.
model Financial_Payable {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  supplierId  Int?
  supplier    Financial_Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  description String              @db.VarChar(255)
  value       Decimal             @db.Decimal(18, 2)
  dueDate     DateTime
  // competência AAAA-MM
  accrualDate String              @db.VarChar(7)
  // aberta | paga
  status      String              @default("aberta") @db.VarChar(12)

  // nota ou documento do fornecedor
  documentNumber String? @db.VarChar(60)
  paymentMethod  String? @db.VarChar(20)

  // parcelas de um mesmo lançamento compartilham o groupKey
  installmentNumber Int?
  installmentTotal  Int?
  groupKey          String? @db.VarChar(40)

  // de onde veio: manual | pedido_compra; e a obra, quando o gasto é de uma OS
  origin          String         @default("manual") @db.VarChar(20)
  // guia de imposto paga (das | iss | inss | irpj | csll | pis | cofins): cruza com
  // as retenções dos clientes no mesmo mês para avisar de imposto pago duas vezes
  taxKind         String?        @db.VarChar(10)
  serviceOrderId  Int?
  serviceOrder    Service_Order? @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  purchaseOrderId Int?

  chartAccountId Int?
  chartAccount   Financial_ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)
  costCenterId   Int?
  costCenter     Financial_CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  // baixa: quando saiu, quanto, de qual conta e quem lançou
  paidAt          DateTime?
  paidValue       Decimal?               @db.Decimal(18, 2)
  bankAccountId   Int?
  bankAccount     Financial_BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  settledByUserId Int?

  // juros, multa e desconto informados na baixa (valor pago = valor + juros + multa − desconto)
  interestValue Decimal? @db.Decimal(18, 2)
  fineValue     Decimal? @db.Decimal(18, 2)
  discountValue Decimal? @db.Decimal(18, 2)

  // para pagar sem abrir o PDF: linha digitável do boleto e PIX copia e cola
  barcode String? @db.VarChar(60)
  pixCode String? @db.Text

  // anexos
  billUrl    String? @db.Text
  invoiceUrl String? @db.Text
  receiptUrl String? @db.Text

  // gerada por uma despesa recorrente
  recurrenceId Int?
  recurrence   Financial_Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  // identificador da linha do extrato (OFX) que conciliou esta baixa
  statementRef String?               @db.VarChar(80)

  observations    String? @db.VarChar(500)
  createdByUserId Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, status, dueDate])
  @@index([companyId, accrualDate])
  @@index([companyId, supplierId])
  @@index([companyId, serviceOrderId])
  @@index([companyId, purchaseOrderId])
  @@index([groupKey])
  @@index([companyId, recurrenceId])
}

// Lançamento que se repete todo mês (aluguel, internet, contador; ou uma
// mensalidade a receber). Gera as próximas ocorrências em aberto, sempre
// cobrindo os próximos `horizonMonths` meses, até ser encerrado.
model Financial_Recurrence {
  id             Int       @id @default(autoincrement())
  companyId      Int
  // payable | receivable
  kind           String    @db.VarChar(12)
  description    String    @db.VarChar(255)
  value          Decimal   @db.Decimal(18, 2)
  // dia do vencimento (1 a 31; em mês curto cai no último dia)
  dayOfMonth     Int
  // primeiro vencimento e, se houver, o último
  startDate      DateTime
  endDate        DateTime?
  // até quando já foram geradas ocorrências
  generatedUntil DateTime?

  supplierId      Int?
  customerId      Int?
  chartAccountId  Int?
  costCenterId    Int?
  serviceOrderId  Int?
  paymentMethod   String? @db.VarChar(20)
  observations    String? @db.VarChar(500)
  createdByUserId Int?

  payables    Financial_Payable[]
  receivables FinancialRecords[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, kind])
}

// Transferência entre contas da empresa (caixa → banco, banco → banco).
// Mexe no saldo das duas contas e não é receita nem despesa.
model Financial_Transfer {
  id                Int                   @id @default(autoincrement())
  companyId         Int
  fromBankAccountId Int
  fromBankAccount   Financial_BankAccount @relation("TransferFrom", fields: [fromBankAccountId], references: [id], onDelete: Restrict)
  toBankAccountId   Int
  toBankAccount     Financial_BankAccount @relation("TransferTo", fields: [toBankAccountId], references: [id], onDelete: Restrict)
  value             Decimal               @db.Decimal(18, 2)
  date              DateTime
  description       String?               @db.VarChar(255)
  statementRef      String?               @db.VarChar(80)
  createdByUserId   Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, date])
}

// Configuração do financeiro da empresa. `startDate` é a data de implantação:
// a partir dela o sistema acompanha o caixa. O saldo inicial de cada conta é o
// saldo no fim do dia anterior; o que foi pago/recebido antes não mexe no saldo.
model Financial_Settings {
  id              Int       @id @default(autoincrement())
  companyId       Int       @unique
  startDate       DateTime?
  updatedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Extrato lido pelo assistente (PDF) ou enviado pelo MCP: rascunho até a pessoa revisar e lançar pela conciliação.
model Financial_StatementDraft {
  id              Int                   @id @default(autoincrement())
  companyId       Int
  bankAccountId   Int
  bankAccount     Financial_BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  source          String                @default("pdf") @db.VarChar(10) // pdf | mcp
  status          String                @default("rascunho") @db.VarChar(20) // rascunho | nao_confere | parcial | lancado | descartado
  fileName        String?               @db.VarChar(200)
  periodFrom      String                @db.VarChar(10)
  periodTo        String                @db.VarChar(10)
  openingBalance  Decimal               @db.Decimal(18, 2)
  closingBalance  Decimal               @db.Decimal(18, 2)
  difference      Decimal               @default(0) @db.Decimal(18, 2) // saldo inicial + linhas - saldo final
  lines           Json // [{ fitId, date, amount, memo, suggestion? }]
  applyResult     Json?
  botId           Int?
  createdByUserId Int?
  appliedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([companyId, status])
  @@index([bankAccountId])
}

// Imposto retido pelo cliente na nota (ISS, INSS, IR, PIS, COFINS, CSLL): o cliente
// desconta do pagamento e recolhe ele mesmo. A conta a receber fica com o
// líquido; aqui fica cada retenção, para o relatório "não pagar de novo na guia".
model Financial_Retention {
  id                Int              @id @default(autoincrement())
  companyId         Int
  financialRecordId Int
  financialRecord   FinancialRecords @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)
  customerId        Int?
  contractId        Int?
  measurementId     Int?
  // iss | inss | ir | pis | cofins | csll
  tax               String           @db.VarChar(10)
  // alíquota em % sobre a base (nula quando só o valor foi informado)
  rate              Decimal?         @db.Decimal(7, 4)
  // valor da nota sobre o qual o imposto foi retido
  base              Decimal          @db.Decimal(18, 2)
  value             Decimal          @db.Decimal(18, 2)
  // competência da nota (AAAA-MM): o mês da guia em que o retido é descontado
  accrualDate       String           @db.VarChar(7)
  invoiceNumber     String?          @db.VarChar(60)
  // informado na guia (DAS/ISS) como retido: não pagar de novo
  declaredAt        DateTime?
  declaredByUserId  Int?
  createdByUserId   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId, accrualDate])
  @@index([financialRecordId])
}
