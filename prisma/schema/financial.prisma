// Cadastros do financeiro: plano de contas (conta mãe/filha), centros de
// custo e contas bancárias. Classificam os lançamentos de FinancialRecords.

enum ChartAccountNature {
  receita
  despesa
}

enum BankAccountType {
  corrente
  poupanca
  caixa
  gateway // saldo no provedor de pagamento (ex.: Asaas)
}

// Plano de contas em até 3 níveis. A hierarquia fica em `parentId` e também
// no `code` (1, 1.2, 1.2.3), gerado pela API. Só conta sem filhas
// (`acceptsEntries`) recebe lançamento.
model Financial_ChartAccount {
  id             Int                      @id @default(autoincrement())
  companyId      Int
  parentId       Int?
  parent         Financial_ChartAccount?  @relation("ChartAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Financial_ChartAccount[] @relation("ChartAccountTree")
  code           String                   @db.VarChar(20)
  name           String                   @db.VarChar(120)
  nature         ChartAccountNature
  level          Int
  acceptsEntries Boolean                  @default(true)
  dreGroup       String?                  @db.VarChar(40)
  // Raízes (1 Receitas, 2 Despesas): não editáveis nem inativáveis.
  isSystem       Boolean                  @default(false)

  financialRecords       FinancialRecords[]
  classificationDefaults Financial_ClassificationDefault[]

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model Financial_CostCenter {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(120)
  code        String? @db.VarChar(20)
  description String? @db.VarChar(255)

  financialRecords       FinancialRecords[]
  classificationDefaults Financial_ClassificationDefault[]

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}

model Financial_BankAccount {
  id                 Int             @id @default(autoincrement())
  companyId          Int
  name               String          @db.VarChar(120)
  type               BankAccountType @default(corrente)
  bankCode           String?         @db.VarChar(10)
  bankName           String?         @db.VarChar(120)
  agency             String?         @db.VarChar(20)
  agencyDigit        String?         @db.VarChar(5)
  account            String?         @db.VarChar(30)
  accountDigit       String?         @db.VarChar(5)
  pixKey             String?         @db.VarChar(140)
  holderName         String?         @db.VarChar(255)
  holderDocument     String?         @db.VarChar(20)
  openingBalance     Decimal         @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime?
  // Conta do tipo gateway: de qual provedor é o saldo.
  gateway            gateways?
  isDefault          Boolean         @default(false)

  financialRecords FinancialRecords[]

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@unique([companyId, name])
}

// Classificação que um recebível ganha sozinho conforme a origem
// (ex.: `inscricao` = checkout de turma). Editável em Financeiro.
model Financial_ClassificationDefault {
  id             Int                     @id @default(autoincrement())
  companyId      Int
  origin         String                  @db.VarChar(40)
  chartAccountId Int?
  chartAccount   Financial_ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)
  costCenterId   Int?
  costCenter     Financial_CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([companyId, origin])
}

// Fornecedores: de quem a empresa compra, aluga ou contrata. Cadastro simples,
// usado nas contas a pagar e (depois) nos pedidos de compra.
model Financial_Supplier {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(160)
  // razão social, quando o nome acima é o fantasia
  legalName   String? @db.VarChar(200)
  // CNPJ ou CPF, só dígitos
  document    String? @db.VarChar(14)
  // o que fornece (ex.: locação de andaimes)
  supplies    String? @db.VarChar(255)
  contactName String? @db.VarChar(120)
  email       String? @db.VarChar(160)
  phone       String? @db.VarChar(30)
  pixKey      String? @db.VarChar(140)
  bankName    String? @db.VarChar(120)
  agency      String? @db.VarChar(20)
  account     String? @db.VarChar(30)
  notes       String? @db.VarChar(500)

  payables Financial_Payable[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, name])
  @@index([companyId, document])
}

// Contas a pagar. Tabela separada dos recebíveis (FinancialRecords é presa a
// cliente, aluno e gateway). "Atrasada" não é situação gravada: é conta aberta
// com vencimento passado, calculada na leitura.
model Financial_Payable {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  supplierId  Int?
  supplier    Financial_Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  description String              @db.VarChar(255)
  value       Decimal             @db.Decimal(18, 2)
  dueDate     DateTime
  // competência AAAA-MM
  accrualDate String              @db.VarChar(7)
  // aberta | paga
  status      String              @default("aberta") @db.VarChar(12)

  // nota ou documento do fornecedor
  documentNumber String? @db.VarChar(60)
  paymentMethod  String? @db.VarChar(20)

  // parcelas de um mesmo lançamento compartilham o groupKey
  installmentNumber Int?
  installmentTotal  Int?
  groupKey          String? @db.VarChar(40)

  // de onde veio: manual | pedido_compra; e a obra, quando o gasto é de uma OS
  origin          String         @default("manual") @db.VarChar(20)
  serviceOrderId  Int?
  serviceOrder    Service_Order? @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  purchaseOrderId Int?

  chartAccountId Int?
  chartAccount   Financial_ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)
  costCenterId   Int?
  costCenter     Financial_CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  // baixa: quando saiu, quanto, de qual conta e quem lançou
  paidAt          DateTime?
  paidValue       Decimal?               @db.Decimal(18, 2)
  bankAccountId   Int?
  bankAccount     Financial_BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  settledByUserId Int?

  // anexos
  billUrl    String? @db.Text
  invoiceUrl String? @db.Text
  receiptUrl String? @db.Text

  observations    String? @db.VarChar(500)
  createdByUserId Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  inactiveAt DateTime?

  @@index([companyId, status, dueDate])
  @@index([companyId, accrualDate])
  @@index([companyId, supplierId])
  @@index([companyId, serviceOrderId])
  @@index([companyId, purchaseOrderId])
  @@index([groupKey])
}
