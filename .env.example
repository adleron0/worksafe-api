# Configurações de Segurança

# Liga/desliga completamente o módulo de segurança (true/false)
SECURITY_ENABLED=true

# Número de proxies confiáveis antes do servidor (importante para rate limiting)
# Use 1 se tiver apenas nginx, 2 se tiver cloudflare + nginx, etc
TRUST_PROXY_HOPS=1

# Número máximo de requisições por minuto (padrão: 200)
SECURITY_MAX_REQUESTS=200

# Lista de IPs na whitelist, separados por vírgula
# SECURITY_WHITELIST=192.168.1.1,10.0.0.1

# Lista de IPs na blacklist, separados por vírgula  
# SECURITY_BLACKLIST=100.64.0.11,100.64.0.14

# Habilita notificações de alertas de segurança (true/false)
SECURITY_ENABLE_NOTIFICATIONS=true

# URL do webhook para notificações de segurança
# SECURITY_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ============================================
# Google OAuth (Blog - Visitantes)
# ============================================

# Credenciais do Google Cloud Console
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# URL de callback do OAuth (deve ser o backend/API)
# Desenvolvimento: http://localhost:3000/blog/auth/google/callback
# Produção: https://api.seudominio.com.br/blog/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/blog/auth/google/callback

# URL padrão de redirecionamento após autenticação (frontend)
# Usado quando o frontend não envia redirectUrl no query param
BLOG_DEFAULT_REDIRECT=http://localhost:3030/blog

# Secret para tokens JWT de visitantes do blog
JWT_VISITOR_SECRET=sua_chave_secreta_aqui

# ============================================
# AI Service (Geração de Artigos)
# ============================================

# Chave da API de IA (Groq ou Gemini)
AI_API_KEY=sua_api_key

# Provedor de IA: GROQ ou GEMINI
AI_USING=GROQ